# Copy to .env.local and fill in. Never commit real values.
#
# Local: run `pnpm supabase start` (needs Docker), then `pnpm supabase status`
# and copy the API URL, publishable key and secret key from its output.
# Cloud: Supabase dashboard → Project Settings → API Keys.

# Public — inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — bypasses RLS. Used by Server Actions for scoring (docs/02-architecture.md).
# Accepts the new `sb_secret_…` key or the legacy service_role JWT.
SUPABASE_SECRET_KEY=

# Server only — signs participant tokens (quiz takers have no account). At least 32 random
# characters; changing it logs every participant out. Generate: openssl rand -base64 48
PARTICIPANT_TOKEN_SECRET=

# Show "Lanjut dengan Google" on /login. Also enable the provider in Supabase
# (supabase/config.toml [auth.external.google] locally, or the dashboard in the cloud).
NEXT_PUBLIC_AUTH_GOOGLE=false

# Server only — optional. Lets the scheduler call /api/webhooks/dispatch to retry webhook
# deliveries (docs/07-embed.md#webhook). At least 32 random characters; put the same value in
# Supabase Vault as `quiz_cron_secret` (or Vercel Cron sends it). openssl rand -base64 48
CRON_SECRET=

# Server only — optional. Enables "Buat dengan AI" in the editor (Gemini API, P8-10). Without
# it the button is hidden. Uploaded PDFs and pasted text are sent to Google's Gemini API: use a
# key from a project with billing on (paid tier), so the material isn't used to train models.
GEMINI_API_KEY=
# Optional: Gemini models in order, comma-separated (default gemini-3.5-flash,gemini-3.1-flash-lite).
# The next one is tried when a model is overloaded (503) or out of quota (429).
GEMINI_MODEL=
# Optional: generations per teacher per 24 hours (default 20).
AI_DAILY_LIMIT=
